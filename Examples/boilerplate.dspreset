<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal starting-point preset for the DecentSampler Visual Editor.
  One group, one sample mapped across the full keyboard range, no UI
  controls or effects. Open this in the editor and add samples, groups,
  and controls from there.
-->
<DecentSampler minVersion="1.0.0" presetName="Boilerplate">
  <groups attack="0.001" decay="0.0" sustain="1.0" release="0.3" volume="0dB">
    <group>
      <sample path="Samples/placeholder.wav" loNote="0" hiNote="127" rootNote="60" />
    </group>
  </groups>
</DecentSampler>
